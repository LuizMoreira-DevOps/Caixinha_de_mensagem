<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💌"
            android:textSize="54sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txtTituloApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caixinha da Cami"
            android:textColor="@color/text_light"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolha uma gavetinha e tire um papelzinho."
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:gravity="center"
            android:alpha="0.9"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnLeiaQuandoPrecisar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leia quando precisar"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:background="@drawable/bg_button"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOQueGosto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O que eu gosto em você"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:background="@drawable/bg_button"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnUniverso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu lugar no meu universo"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:background="@drawable/bg_button"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/cardMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_papelzinho"
            android:orientation="vertical"
            android:elevation="8dp">

            <TextView
                android:id="@+id/txtGaveta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sua caixinha"
                android:textColor="@color/rose_medium"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Papelzinho especial"
                android:textColor="@color/gold_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtTituloMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escolha uma gavetinha"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quando você tocar em um dos botões, eu vou tirar um papelzinho especial para você."
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtRodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feito com amor por Nando."
            android:textColor="@color/text_light"
            android:textSize="13sp"
            android:gravity="center"
            android:alpha="0.8"
            android:layout_marginTop="22dp" />

    </LinearLayout>

</ScrollView>