<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="74dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/txtIcone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💌"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/txtTituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Caixinha da Cami"
            android:textColor="@color/cami_creme"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Escolha uma gavetinha e tire um papelzinho."
            android:textColor="@color/cami_creme"
            android:textSize="14sp"
            android:alpha="0.9" />

        <LinearLayout
            android:id="@+id/containerBotoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnLeiaQuandoPrecisar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:backgroundTint="@color/cami_roxo"
                android:text="Leia quando precisar"
                android:textAllCaps="false"
                android:textColor="@color/cami_texto_botao"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOQueGosto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:backgroundTint="@color/cami_roxo"
                android:text="O que eu gosto em você"
                android:textAllCaps="false"
                android:textColor="@color/cami_texto_botao"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUniverso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:backgroundTint="@color/cami_roxo"
                android:text="Seu lugar no meu universo"
                android:textAllCaps="false"
                android:textColor="@color/cami_texto_botao"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDivisorMusica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="ou escolha uma lembrança musical"
                android:textColor="@color/cami_creme"
                android:textSize="12sp"
                android:alpha="0.82" />

            <Button
                android:id="@+id/btnMusicas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/cami_dourado"
                android:text="🎵 Trilha sonora de nós"
                android:textAllCaps="false"
                android:textColor="@color/cami_vinho_escuro"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_card_papel"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/txtGaveta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escolha uma gavetinha"
                android:textColor="@color/cami_marsala"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Seu papelzinho aparecerá aqui"
                android:textColor="@color/cami_marsala"
                android:textSize="12sp"
                android:alpha="0.85" />

            <TextView
                android:id="@+id/txtTituloMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Caixinha da Cami"
                android:textColor="@color/cami_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:text="Toque em uma gavetinha para tirar um papelzinho especial."
                android:textColor="@color/cami_texto"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtRodape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Feito com amor por Nando."
            android:textColor="@color/cami_creme"
            android:textSize="12sp"
            android:alpha="0.9" />

    </LinearLayout>

</ScrollView>